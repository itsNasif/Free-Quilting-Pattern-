# ── QuiltHaven environment ──────────────────────────────────────────────
# Copy this file to .env.local and fill in the values you have.
# The site runs fully on bundled demo patterns until Supabase/Cloudinary are
# configured; the demo fallback switches off automatically as you add keys.

# ── Supabase (patterns + file storage) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the admin/API routes for writes. NEVER expose in client code.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudinary (pattern preview images) ────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ── Admin passcode (sign-in for /admin) ────────────────────────────────
# Pick a long, random value. The site signs a session cookie with it.
ADMIN_PASSWORD=quilthaven-change-me

# ── Adsterra ads ───────────────────────────────────────────────────────
# Adsterra units served via spongeascend.com
NEXT_PUBLIC_ADSTERRA_BANNER_728X90_ID=d271bc5ea80da947787f13dde8a02f77
NEXT_PUBLIC_ADSTERRA_NATIVE_BANNER_ID=c6d3de3e1b3bcdb420e24ca97ecfcb30
NEXT_PUBLIC_ADSTERRA_POPUNDER_ID=cbcceda9d4382ce4e1b0946735a4e984
NEXT_PUBLIC_ADSTERRA_SOCIAL_BAR_ID=1cc3b1ea0866be84b9d2e18be1c082b2
NEXT_PUBLIC_ADSTERRA_SMARTLINK_ID=ad3ba3d1a22637f2aceb6a1848b3a7bc
NEXT_PUBLIC_ADSTERRA_SMARTLINK_URL=https://spongeascend.com/zmrzjg6yv7?key=ad3ba3d1a22637f2aceb6a1848b3a7bc

# ── Site ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
